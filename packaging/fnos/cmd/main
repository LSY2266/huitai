#!/bin/bash
# 绘台 Huitai 生命周期脚本：容器由飞牛应用中心按 docker-compose.yaml 启动/停止，
# 这里只负责把「是否正在运行」如实上报给应用中心（status 退出码 0=运行中，3=已停止）。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
DOCKER_NAME="huitai"

if [ -f "$FILE_PATH" ]; then
    DETECTED=$(grep -E '^[[:space:]]*container_name' "$FILE_PATH" | head -1 | awk -F ':' '{print $2}' | xargs)
    [ -n "$DETECTED" ] && DOCKER_NAME="$DETECTED"
fi

is_docker_running() {
    docker inspect -f '{{.State.Running}}' "$DOCKER_NAME" 2>/dev/null | grep -q '^true$'
}

case $1 in
start)
    # 启停由应用中心调 docker compose 完成，这里无需重复操作
    exit 0
    ;;
stop)
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
